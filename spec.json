{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/app/dist/schema.json",

  "assembly": "hg38",

  "specId": "GenomeSpy paper example",

  "bookmarks": {
    "remote": {
      "url": "tour.json",
      "tour": true
    }
  },

  "description": [
    "GenomeSpy paper example specification for the DECIDER cohort.",
    "This fork updates the original paper specification to newer GenomeSpy features and the modern visualization schema. The original specification still works."
  ],

  "spacing": 7,

  "vconcat": [
    {
      "import": { "url": "cytobands.json" }
    },

    {
      "name": "blacklist-tracks",
      "title": "Blacklist tracks",
      "description": "Tracks that mask recurrent blacklist regions and cohort-specific artifacts so they can be ignored during interpretation.",
      "spacing": 3,
      "visible": false,

      "vconcat": [
        { "import": { "url": "hg38-blacklist.v2.json" } },
        { "import": { "url": "decider-cnv-blacklist.json" } }
      ]
    },

    {
      "name": "samples",
      "title": "DECIDER samples",
      "description": "Sample-level tracks for the ovarian cancer cohort. The sample view supports interactive filtering, grouping, and shared genomic coordinates across tracks.",

      "stickySummaries": true,

      "samples": {
        "identity": {
          "data": { "url": "decider-data/samples.tsv" },
          "idField": "sample",
          "displayNameField": "displayName"
        },
        "metadataSources": [
          {
            "name": "metadata",
            "description": "Static sample metadata loaded from samples.tsv.",
            "initialLoad": "*",
            "excludeColumns": ["displayName"],
            "backend": {
              "backend": "data",
              "data": { "url": "decider-data/samples.tsv" },
              "sampleIdField": "sample"
            },

            "attributes": {
              "sampleTime": {
                "type": "ordinal",
                "scale": {
                  "domain": ["primary", "interval", "relapse"],
                  "range": ["#facf5a", "#f95959", "#455d7a"]
                }
              },
              "diagnosis": {
                "type": "nominal"
              },
              "ploidy": {
                "type": "quantitative",
                "scale": {
                  "scheme": "yellowgreenblue"
                }
              },
              "purity": {
                "type": "quantitative",
                "scale": {
                  "domain": [0, 1],
                  "scheme": "yellowgreenblue"
                }
              },
              "sig_HRD": {
                "type": "quantitative",
                "scale": {
                  "scheme": "yelloworangered"
                }
              },
              "sig_APOBEC": {
                "type": "quantitative",
                "scale": {
                  "scheme": "yelloworangered"
                }
              },
              "mutations": {
                "type": "quantitative",
                "scale": {
                  "domain": [0, 60000],
                  "scheme": "lightorange"
                }
              },
              "breaks": {
                "type": "quantitative",
                "scale": {
                  "scheme": "lightorange"
                },
                "barScale": {},
                "width": 20
              }
            }
          }
        ]
      },

      "spec": {
        "title": "Genomic data",
        "description": "Copy-number segments and short variants shown for each sample.",

        "resolve": {
          "scale": { "color": "independent", "fill": "independent" }
        },

        "layer": [
          { "import": { "url": "cnv-segments.json" } },
          { "import": { "url": "short-variants.json" } }
        ]
      }
    },

    { "import": { "url": "refSeq-genes.json" } },
    { "import": { "url": "platinum-resistance.json" } }
  ]
}
